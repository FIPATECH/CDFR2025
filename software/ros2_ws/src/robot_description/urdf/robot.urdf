<?xml version="1.0"?>
<robot name="robot">

  <!-- ========================================================= -->
  <!--  Materials                                                -->
  <!-- ========================================================= -->
  <material name="robot_silver">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <!-- ========================================================= -->
  <!--  Transmissions                                            -->
  <!-- ========================================================= -->
  <transmission name="left_wheel_tr">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_wheel_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_wheel_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="right_wheel_tr">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="right_wheel_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wheel_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ========================================================= -->
  <!--  Links                                                    -->
  <!-- ========================================================= -->

  <!-- Root link: MUST have *no* inertial to satisfy KDL -->
  <link name="base_link"/>

  <!-- Dummy child carrying the chassis inertial -->
  <link name="base_chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Replace with measured values if available -->
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0004" iyz="0.0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Roue_g.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_silver"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Roue_g.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0004" iyz="0.0" izz="0.0002"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Roue_d.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_silver"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Roue_d.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Sensors -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.66"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0" izz="0.0003"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_silver"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="realsense_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.046"/>
      <inertia ixx="0.000028" ixy="0.0" ixz="0.0"
               iyy="0.000004" iyz="0.0" izz="0.000028"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/realsense.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_silver"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/realsense.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================= -->
  <!--  Joints                                                   -->
  <!-- ========================================================= -->

  <!-- Fixed joint to carry inertial from chassis to root -->
  <joint name="base_chassis_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_chassis"/>
  </joint>

  <!-- Drive wheels -->
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.105 0.0422" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.105 0.0422" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Sensor mounts -->
  <joint name="lidar_fixed" type="fixed">
    <origin xyz="-0.01 0 0.3692" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <joint name="realsense_fixed" type="fixed">
    <origin xyz="0.051175 0.005 0.303446" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="realsense_link"/>
  </joint>

</robot>